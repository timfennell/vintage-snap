// The RAW developer: the sensor's 16-bit values to an upright, scene-linear
// picture (linear sRGB primaries, D65). Black and white levels, the lens
// shading map (a phone's RAW isn't corrected for its own fall-off), Malvar-He-
// Cutler gradient-corrected demosaicing, white balance (the as-shot neutral),
// camera -> XYZ (D50) through the forward matrix, XYZ -> linear sRGB.
// One invocation per sensor pixel, written where it lands upright.
precision highp usampler2D;
uniform usampler2D uRaw;         // R16UI, the sensor's values (landscape)
layout(rgba16f, binding = 0) writeonly uniform image2D uOut;   // upright
uniform vec4 uBlack;             // black level at the 2 x 2 positions (0,0) (1,0) (0,1) (1,1)
uniform float uWhite;
uniform int uCfa;                // 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR
uniform vec3 uNeutral;           // the as-shot neutral (camera rgb of white)
uniform mat3 uCamToXyz;          // forward matrix (white-balanced camera -> XYZ D50)
uniform int uRotate;             // clockwise degrees to make it upright: 0, 90, 180, 270
uniform sampler2D uShading;      // RGBA: gain for R, G (R rows), G (B rows), B; 1x1 white when none
uniform float uHasShading;

// The colour at a sensor position: 0 R, 1 G on a red row, 2 G on a blue row, 3 B.
int colourAt(ivec2 s) {
    int i = (s.x & 1) + 2 * (s.y & 1);
    if (uCfa == 0) return i == 0 ? 0 : (i == 3 ? 3 : (i == 1 ? 1 : 2));
    if (uCfa == 1) return i == 1 ? 0 : (i == 2 ? 3 : (i == 0 ? 1 : 2));
    if (uCfa == 2) return i == 2 ? 0 : (i == 1 ? 3 : (i == 3 ? 1 : 2));
    return i == 3 ? 0 : (i == 0 ? 3 : (i == 2 ? 1 : 2));
}

ivec2 sz;
vec2 shadeUv;
float v(ivec2 s) {
    s = clamp(s, ivec2(0), sz - 1);
    int i = (s.x & 1) + 2 * (s.y & 1);
    float b = uBlack[i];
    float x = (float(texelFetch(uRaw, s, 0).r) - b) / max(uWhite - b, 1.0);
    if (uHasShading > 0.5) x *= texture(uShading, (vec2(s) + 0.5) / vec2(sz))[colourAt(s)];
    return x;
}

void main() {
    ivec2 s = ivec2(gl_GlobalInvocationID.xy);
    sz = textureSize(uRaw, 0);
    if (s.x >= sz.x || s.y >= sz.y) return;
    int c = colourAt(s);
    float C = v(s);
    float N = v(s + ivec2(0, -1)), S = v(s + ivec2(0, 1)), E = v(s + ivec2(1, 0)), W = v(s + ivec2(-1, 0));
    float NN = v(s + ivec2(0, -2)), SS = v(s + ivec2(0, 2)), EE = v(s + ivec2(2, 0)), WW = v(s + ivec2(-2, 0));
    float NE = v(s + ivec2(1, -1)), NW = v(s + ivec2(-1, -1)), SE = v(s + ivec2(1, 1)), SW = v(s + ivec2(-1, 1));
    vec3 rgb;
    if (c == 0 || c == 3) {
        // at red (or blue): green, and the other of red / blue
        float g = (4.0 * C + 2.0 * (N + S + E + W) - (NN + SS + EE + WW)) / 8.0;
        float o = (6.0 * C + 2.0 * (NE + NW + SE + SW) - 1.5 * (NN + SS + EE + WW)) / 8.0;
        rgb = c == 0 ? vec3(C, g, o) : vec3(o, g, C);
    } else {
        // at green: the colour beside it in this row, and the one above / below
        float rowC = (5.0 * C + 4.0 * (E + W) - (EE + WW) - (NE + NW + SE + SW) + 0.5 * (NN + SS)) / 8.0;
        float colC = (5.0 * C + 4.0 * (N + S) - (NN + SS) - (NE + NW + SE + SW) + 0.5 * (EE + WW)) / 8.0;
        // green on a red row has red beside it, blue above and below
        rgb = c == 1 ? vec3(rowC, C, colC) : vec3(colC, C, rowC);
    }
    rgb = max(rgb, 0.0) / max(uNeutral, vec3(1e-4));        // white balance
    vec3 xyz = uCamToXyz * rgb;
    const mat3 XYZ_TO_SRGB_D50 = mat3(                         // Bradford-adapted D50 -> linear sRGB (columns)
        3.1338561, -0.9787684, 0.0719453,
        -1.6168667, 1.9161415, -0.2289914,
        -0.4906146, 0.0334540, 1.4052427);
    vec3 lin = max(XYZ_TO_SRGB_D50 * xyz, 0.0);
    ivec2 o;
    if (uRotate == 90) o = ivec2(sz.y - 1 - s.y, s.x);
    else if (uRotate == 180) o = ivec2(sz.x - 1 - s.x, sz.y - 1 - s.y);
    else if (uRotate == 270) o = ivec2(s.y, sz.x - 1 - s.x);
    else o = s;
    imageStore(uOut, o, vec4(lin, 1.0));
}
