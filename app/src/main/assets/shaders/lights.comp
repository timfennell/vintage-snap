// Light detection: each 16-pixel tile's light above a threshold (what could
// throw a flare): its energy, where it sits (energy-weighted), how many pixels,
// and its blur. The CPU joins neighbouring tiles into light sources.
uniform sampler2D uWork;         // rgb (linear, point lights restored) + signed coc
uniform float uThreshold;
uniform int uSrgb;               // 1: an sRGB picture (the camera's whole frame), linearised here
layout(rgba32f, binding = 0) writeonly uniform image2D uEnergy;   // rgb energy, bright pixel count
layout(rgba32f, binding = 1) writeonly uniform image2D uWhere;    // sum x*e, sum y*e, sum |coc|*e, sum e (luma)

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tsz = imageSize(uEnergy);
    if (t.x >= tsz.x || t.y >= tsz.y) return;
    ivec2 sz = textureSize(uWork, 0);
    vec3 e = vec3(0.0); float n = 0.0, sx = 0.0, sy = 0.0, sc = 0.0, se = 0.0;
    for (int y = 0; y < 16; y++) for (int x = 0; x < 16; x++) {
        ivec2 p = t * 16 + ivec2(x, y);
        if (p.x >= sz.x || p.y >= sz.y) continue;
        vec4 c = texelFetch(uWork, p, 0);
        if (uSrgb == 1) c = vec4(to_lin(c.rgb), 0.0);
        float l = luma(c.rgb);
        if (l <= uThreshold) continue;
        e += c.rgb; n += 1.0;
        sx += (float(p.x) + 0.5) * l; sy += (float(p.y) + 0.5) * l; sc += abs(c.a) * l; se += l;
    }
    imageStore(uEnergy, t, vec4(e, n));
    imageStore(uWhere, t, vec4(sx, sy, sc, se));
}
