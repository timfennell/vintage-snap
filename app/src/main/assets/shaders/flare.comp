// Lens flare and light leaks, ported from Vintage Click's lens_flare / light_leak
// (Shaders.swift), the lights found in the photo (lights.comp, Flare.kt) in place
// of lights placed in a scene. Per light: ghosts (the aperture's shape strung
// along the line through the axis, round wide open, the blades' polygon stopped
// down, tinted by the coating, fringed by dispersion, showing the glass's dust,
// bubbles, cleaning marks and fungus), veiling glare, a faint ring, the filter's
// own glass ghost, coating scratches, and the starburst off the iris's corners.
// A loose (whacked) lens adds its leak: light pouring in round the gap.
//   F[0] = (lights, blades, blade rotation, openness)  F[1] = (single-coated, seed, obstruction, squeeze)
//   F[2] = (axis uv, dispersion, field softness)  F[3] = (filter glass, -, -, -)
//   per light: F[4+3i] = (uv, radius / diagonal, visible), F[5+3i] = (flare rgb, own blur / diagonal)
//   F[28] = leak (strength, gap direction x right y down, seed)
uniform sampler2D uIn;           // RGBA16F linear picture after the lens
uniform sampler2D uWork;         // the sharp picture's mips (the leak reads the frame's edges from them)
layout(rgba16f, binding = 0) writeonly uniform image2D uOut;
uniform vec4 uF[29];
uniform ivec2 uOffset;

float flare_hash(float s, float k) { return fract(sin(s * 12.9898 + k * 78.233) * 43758.5453); }

float aperture_mask(vec2 d, float soft) {
    float r = length(d);
    int nb = int(uF[0].y);
    float open = uF[0].w;
    float edge = r;
    if (nb >= 3 && open < 0.98) {
        float seg = 2.0 * PI / float(nb);
        float th = atan(d.y, d.x) - uF[0].z;
        float a = mod(th, seg) - seg * 0.5;
        float poly = r * cos(a) / cos(PI / float(nb));
        edge = mix(poly, r, smoothstep(0.75, 0.98, open));
    }
    float m = 1.0 - smoothstep(1.0 - soft, 1.0 + soft, edge);
    if (uF[1].z > 0.0) m *= smoothstep(uF[1].z - soft, uF[1].z + soft, r);   // a mirror lens: a ring
    return m;
}

bool fungus(float seed, float dust) { return dust >= 2.0 && flare_hash(seed, 1300.0) < 0.55; }

float glass_flaws(vec2 d, float seed, float k, float dust, bool bubbles) {
    if (dust <= 0.0 && !bubbles) return 1.0;
    float m = 1.0;
    int specks = int(dust * 4.0);
    for (int i = 0; i < 12; i++) {
        if (i >= specks) break;
        float h = k * 37.0 + float(i) * 3.0 + 200.0;
        float a = flare_hash(seed, h) * 6.2831853, r = sqrt(flare_hash(seed, h + 1.0)) * 0.92;
        float sz = mix(0.022, 0.07, flare_hash(seed, h + 2.0));
        float q = length(d - r * vec2(cos(a), sin(a))) / sz;
        m *= 1.0 - 0.55 * (1.0 - smoothstep(0.7, 1.0, q)) + 0.18 * exp(-pow((q - 1.15) / 0.18, 2.0));
    }
    if (bubbles) {
        for (int i = 0; i < 3; i++) {
            float h = k * 37.0 + float(i) * 3.0 + 500.0;
            float a = flare_hash(seed, h) * 6.2831853, r = sqrt(flare_hash(seed, h + 1.0)) * 0.85;
            float sz = mix(0.035, 0.10, flare_hash(seed, h + 2.0));
            float q = length(d - r * vec2(cos(a), sin(a))) / sz;
            m *= 1.0 - 0.35 * (1.0 - smoothstep(0.6, 0.95, q)) + 0.45 * exp(-pow((q - 1.0) / 0.12, 2.0));
        }
    }
    float marks = 0.0;
    for (int j = 0; j < 4; j++) {
        float h = k * 37.0 + float(j) * 4.0 + 800.0;
        float a = flare_hash(seed, h) * 6.2831853;
        vec2 c = 1.4 * vec2(cos(a), sin(a));
        float R = length(c) + mix(-0.8, 0.6, flare_hash(seed, h + 1.0));
        float arc = abs(length(d - c) - R);
        float along = atan(d.y - c.y, d.x - c.x) - (a + PI);
        float span = 0.25 + 0.5 * flare_hash(seed, h + 2.0);
        marks += exp(-pow(arc / 0.006, 2.0)) * (1.0 - smoothstep(span * 0.7, span, abs(mod(along + 3.0 * PI, 2.0 * PI) - PI)));
    }
    float scratches = 0.0;
    int ns = int(dust * 2.0);
    for (int j = 0; j < 6; j++) {
        if (j >= ns) break;
        float h = k * 37.0 + float(j) * 5.0 + 1100.0;
        float a = flare_hash(seed, h) * PI;
        vec2 dir = vec2(cos(a), sin(a)), nrm = vec2(-dir.y, dir.x);
        vec2 o = (vec2(flare_hash(seed, h + 1.0), flare_hash(seed, h + 2.0)) - 0.5) * 1.6;
        float along = dot(d - o, dir), off = dot(d - o, nrm);
        float len = 0.15 + 0.6 * flare_hash(seed, h + 3.0);
        scratches += exp(-pow(off / 0.004, 2.0)) * (1.0 - smoothstep(len * 0.8, len, abs(along)));
    }
    float lace = 0.0;
    if (fungus(seed, dust)) {
        for (int c = 0; c < 2; c++) {
            float h = k * 37.0 + float(c) * 9.0 + 1400.0;
            float a = flare_hash(seed, h) * 6.2831853, r = sqrt(flare_hash(seed, h + 1.0)) * 0.8;
            vec2 q = d - r * vec2(cos(a), sin(a));
            float size = mix(0.12, 0.3, flare_hash(seed, h + 2.0));
            float rr = length(q) / size;
            if (rr >= 1.0) continue;
            float th = atan(q.y, q.x);
            float best = 1e3;
            for (int b = 0; b < 7; b++) {
                float tb = float(b) / 7.0 * 6.2831853 + flare_hash(seed, h + 3.0 + float(b));
                float wob = tb + 0.25 * sin(rr * 9.0 + float(b) * 2.1) + 0.12 * sin(rr * 23.0 + float(b));
                float dth = abs(mod(th - wob + 3.0 * PI, 2.0 * PI) - PI);
                best = min(best, dth * rr * size);
                float tb2 = wob + 0.6 * (flare_hash(seed, h + 20.0 + float(b)) - 0.5) * 2.0;
                float dth2 = abs(mod(th - tb2 - 0.4 * sin(rr * 13.0) + 3.0 * PI, 2.0 * PI) - PI);
                if (rr > 0.35) best = min(best, dth2 * rr * size * 1.4);
            }
            float strand = exp(-pow(best / 0.006, 2.0)) * (1.0 - smoothstep(0.6, 1.0, rr));
            lace += strand + 0.6 * (1.0 - smoothstep(0.0, 0.08, rr));
        }
    }
    float polish = 0.05 * sin(d.x * 6.1 + seed) * sin(d.y * 4.7 + seed * 1.7);
    return max(m * (1.0 + polish) * (1.0 - 0.6 * min(lace, 1.0)) + marks * 0.1 * dust + scratches * 0.3
               + 0.15 * min(lace, 1.0) * (1.0 - min(lace, 1.0)) * 4.0, 0.0);
}

vec3 lens_flare(vec2 p, vec2 size) {
    int nl = int(uF[0].x);
    if (nl <= 0) return vec3(0.0);
    float diag = length(size);
    float npx = size.x * size.y;
    bool single = uF[1].x > 0.5;
    float seed = mod(uF[1].y, 10000.0);
    float dust = floor(mod(uF[1].y, 40000.0) / 10000.0);
    bool bubbles = uF[1].y >= 40000.0;
    vec2 axis = uF[2].xy * size;
    vec3 add = vec3(0.0);
    for (int li = 0; li < 8; li++) {
        if (li >= nl) break;
        vec4 a = uF[4 + 3 * li], b = uF[5 + 3 * li];
        if (a.w <= 0.001) continue;
        vec3 I = b.rgb * a.w;
        // How much of a ghost chain this light throws (Flare.rows: only the two that stand out,
        // compact sources; the rest keep their glare and starburst).
        float gw = uF[6 + 3 * li].x;
        bool crowded = uF[3].y > 1.5;
        vec2 s = a.xy * size;
        vec2 v = s - axis;
        // Veiling glare: a broad haze, strongest near the light; worn glass scatters more.
        float rg = diag * 0.35;
        float dg = length(p - s);
        float wear = 1.0 + 0.35 * dust + (fungus(seed, dust) ? 0.8 : 0.0);
        float glare = (single ? 0.006 : 0.0025) * wear / (1.0 + (dg / rg) * (dg / rg));
        add += I * glare * npx / (PI * rg * rg * 3.0);
        // Ghosts along the line through the axis, each the aperture's shape.
        int ng = single ? 7 : 6;
        for (int k = 0; k < 7; k++) {
            if (k >= ng || gw <= 0.001) break;
            float t = mix(-1.6, 1.5, flare_hash(seed, float(k)));
            float rad = diag * mix(0.015, 0.11, flare_hash(seed, float(k) + 20.0)) * mix(0.55, 1.0, uF[0].w);
            float g = (single ? 2e-4 : 2e-5) * mix(0.4, 1.6, flare_hash(seed, float(k) + 40.0));
            float hue = flare_hash(seed, float(k) + 60.0);
            vec3 tint = single ? mix(vec3(1.0, 0.55, 0.2), vec3(0.3, 0.9, 0.5), hue)
                               : mix(vec3(0.45, 0.85, 0.55), vec3(0.85, 0.45, 0.9), hue);
            tint = mix(tint, vec3(1.0), 0.25);
            vec2 cg = axis + v * t;
            float field = length(cg - axis) / diag;
            float focusGhost = b.w * diag / rad * mix(0.15, 1.2, flare_hash(seed, float(k) + 90.0));
            float soft = 0.05 + 0.08 * flare_hash(seed, float(k) + 80.0) + uF[2].w * field + focusGhost;
            // Dispersion: red, green and blue each bend their own amount (fringed edges).
            float bendK = uF[2].z * (single ? 2.0 : 1.0) * (1.0 + 2.0 * abs(t));
            float far = length(p - cg) / (rad * max(uF[1].w, 1.0));
            if (far > (1.0 + 1.6 * abs(bendK)) * (1.0 + soft) + 0.2) continue;
            vec3 m3;
            for (int c = 0; c < 3; c++) {
                float sc = 1.0 + bendK * (float(c) - 1.0) * -1.0;      // red bends least (outermost), blue most
                vec2 d = (p - (axis + v * t * sc)) / (rad * sc);
                d.x /= max(uF[1].w, 0.5);
                m3[c] = aperture_mask(d, soft);
            }
            if (max(m3.r, max(m3.g, m3.b)) <= 0.0) continue;
            vec2 dq = (p - cg) / rad;
            dq.x /= max(uF[1].w, 0.5);
            m3 *= glass_flaws(dq, seed, float(k), dust, bubbles);
            float rim = 0.8 + 0.4 * smoothstep(0.6, 1.0, length((p - cg) / rad));
            // two chains cross at the axis: ghosts there fade so the centre doesn't muddy
            float axisFade = crowded ? smoothstep(0.02 * diag, 0.12 * diag, length(cg - axis)) : 1.0;
            add += I * gw * axisFade * tint * m3 * (g * rim * npx / (PI * rad * rad));
        }
        // Coating scratches: faint streaks through the light.
        for (int j = 0; j < 3; j++) {
            if (float(j) >= dust) break;
            float an = flare_hash(seed, 1600.0 + float(j)) * PI;
            vec2 dir = vec2(cos(an), sin(an));
            float along = abs(dot(p - s, dir)), across = abs(dot(p - s, vec2(-dir.y, dir.x)));
            float Ls = diag * mix(0.012, 0.035, flare_hash(seed, 1610.0 + float(j)));
            float wS = max(1.5, diag * 0.0012);
            float streak = exp(-0.5 * pow(across / wS, 2.0)) * exp(-pow(along / Ls, 1.5));
            add += I * (1e-5 * streak * npx / (Ls * 2.0 * wS * 2.5));
        }
        // A faint ring round the light (a reflection off the film and back).
        float rr = diag * 0.18, w = diag * 0.012 * (1.0 + uF[2].w * 4.0);
        vec3 ring;
        for (int c = 0; c < 3; c++) {
            float rc = rr * (1.0 + uF[2].z * 3.0 * (1.0 - float(c)));
            ring[c] = exp(-0.5 * pow((dg - rc) / w, 2.0));
        }
        add += I * gw * ring * ((single ? 1e-4 : 2e-5) * npx / (2.0 * PI * rr * w * 2.5));
        // A filter's flat glass: a small sharp ghost mirrored through the axis.
        if (uF[3].x > 0.5) {
            vec2 cm = 2.0 * axis - s;
            float rm = max(a.z * diag * 1.3, 2.5);
            float dm = length(p - cm);
            add += I * gw * (8e-4 * exp(-0.5 * (dm / rm) * (dm / rm)) * npx / (2.0 * PI * rm * rm));
        }
        // Starburst: diffraction at the iris's corners, stopped down, lights in focus.
        int nb = int(uF[0].y);
        float corners = 1.0 - smoothstep(0.75, 0.98, uF[0].w);
        float sharp = exp(-b.w * diag / 3.0);
        if (nb >= 3 && dg > 0.5 && corners * sharp > 0.001) {
            int rays = (nb % 2 == 0) ? nb : 2 * nb;
            float th = atan(p.y - s.y, p.x - s.x) - uF[0].z;
            float seg = 2.0 * PI / float(rays);
            float off = mod(th, seg) - seg * 0.5;
            float wpx = 1.1 + 0.5 * exp(-dg / 40.0);
            float spike = exp(-0.5 * pow(off * dg / wpx, 2.0));
            float len = diag * min(0.3, 0.025 / max(uF[0].w, 0.05));
            float fade = pow(len / (len + dg), 2.0) * exp(-dg / (len * 3.0));
            add += I * (6e-5 * corners * sharp * spike * fade * npx / (float(rays) * len * 2.0 * wpx * 2.5 + 1.0));
        }
    }
    return add;
}

// A loose lens: light pouring in round the gap at its back, from whatever is
// bright beside the camera on the gap's side (read from the frame's own edge
// there), warmed by bouncing round the mount.
vec3 light_leak(vec2 p, vec2 size, vec4 L) {
    if (L.x <= 0.0) return vec3(0.0);
    vec2 uv = p / size - 0.5;
    float open = length(L.yz), seed = L.w;
    vec2 gn = open > 0.05 ? L.yz / open : vec2(0.0), side = vec2(-gn.y, gn.x);
    vec3 E = vec3(0.0);
    for (int k = 0; k < 12; k++) {
        vec2 e;
        if (open > 0.05) {
            vec2 edge = gn * 0.47 / max(abs(gn.x), abs(gn.y));
            e = clamp(edge + side * ((float(k) + 0.5) / 12.0 - 0.5) * 0.9, -0.47, 0.47);
        } else {
            float a = (float(k) + 0.5) / 12.0 * 2.0 * PI;
            vec2 d = vec2(cos(a), sin(a));
            e = d * 0.47 / max(abs(d.x), abs(d.y));
        }
        E += textureLod(uWork, e + 0.5, 4.0).rgb;
    }
    E /= 12.0;
    float shape;
    if (open > 0.05) {
        float x = 1.0 - dot(uv, gn) / (0.5 / max(abs(gn.x), abs(gn.y)));
        float sd = dot(uv, side);
        float wash = exp(-x / 0.35);
        float x0 = 0.07 + 0.05 * sin(sd * 3.1 + seed);
        float band = exp(-pow((x - x0) / 0.06, 2.0)) * (0.55 + 0.45 * sin(sd * 4.7 + seed * 2.1));
        shape = 0.9 * wash + 2.0 * open * band;
    } else {
        float x = 1.0 - 2.0 * max(abs(uv.x), abs(uv.y));
        shape = 0.3 * exp(-x / 0.12);
    }
    vec3 warm = luma(E) * vec3(1.0, 0.38, 0.1) / 0.49;
    return mix(E, warm, 0.85) * L.x * (shape + 0.04);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy) + uOffset;
    ivec2 sz = imageSize(uOut);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 size = vec2(sz);
    vec2 pc = vec2(p) + 0.5;
    vec3 c = texelFetch(uIn, p, 0).rgb;
    c += lens_flare(pc, size) + light_leak(pc, size, uF[28]);
    imageStore(uOut, p, vec4(c, 1.0));
}
