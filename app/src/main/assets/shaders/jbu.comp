// Joint bilateral upsampling: the depth network's disparity to full resolution,
// edges taken from the full-resolution picture in colour (not just brightness),
// so the blur boundary follows the subject's outline rather than the network's
// 14-pixel patches. A 6 x 6 window of network pixels; refine.comp then snaps
// what's left to the picture's edges at full resolution.
uniform sampler2D uDispLo;       // R32F, texelFetch only (not filterable)
uniform sampler2D uGuideLo;      // RGBA8: the picture the network saw
uniform sampler2D uSrc;          // RGBA16F: full-resolution linear picture
layout(r32f, binding = 0) writeonly uniform image2D uOut;
uniform float uSigmaRange;
uniform vec4 uWarp;              // the same shift-lens warp as linearize
uniform vec2 uWarpFZ;

vec3 percept(vec3 lin) { return sqrt(max(lin, 0.0)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(uOut);
    if (p.x >= sz.x || p.y >= sz.y) return;
    ivec2 lo = textureSize(uDispLo, 0);
    vec2 fp = shift_uv(vec2(p) + 0.5, vec2(sz), uWarp, uWarpFZ) * vec2(lo) - 0.5;
    ivec2 b = ivec2(floor(fp));
    vec3 g = percept(texelFetch(uSrc, p, 0).rgb);
    float acc = 0.0, wsum = 0.0;
    float inv2s = 1.0 / (2.0 * uSigmaRange * uSigmaRange);
    for (int y = -2; y <= 3; y++) {
        for (int x = -2; x <= 3; x++) {
            ivec2 t = clamp(b + ivec2(x, y), ivec2(0), lo - 1);
            vec2 d = vec2(t) - fp;
            float ws = exp(-0.35 * dot(d, d));
            vec3 gl = percept(to_lin(texelFetch(uGuideLo, t, 0).rgb));
            vec3 dc = g - gl;
            float wr = exp(-dot(dc, dc) * inv2s);
            float w = ws * wr + 1e-6 * ws;
            acc += texelFetch(uDispLo, t, 0).r * w;
            wsum += w;
        }
    }
    imageStore(uOut, p, vec4(acc / wsum));
}
